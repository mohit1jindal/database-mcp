# Oracle MCP server — connection settings (copy to .env, never commit real values)
# Credentials come from the environment only; nothing is hardcoded in source.

# --- Required ---
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=
# DSN: host:port/service_name  (Easy Connect) or a tnsnames.ora alias
ORACLE_DSN=db-host.example.com:1521/ORCLPDB1

# --- Optional: TLS / wallet (Oracle Cloud, mTLS) ---
# ORACLE_CONFIG_DIR=C:\path\to\network\admin     # dir holding tnsnames.ora / sqlnet.ora
# ORACLE_WALLET_LOCATION=C:\path\to\wallet
# ORACLE_WALLET_PASSWORD=

# --- Optional: safety / performance knobs ---
ORACLE_MAX_ROWS=100        # hard ceiling on rows returned per query
ORACLE_QUERY_TIMEOUT=30    # seconds before a query is cancelled
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
