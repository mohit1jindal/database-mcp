# database-mcp — connection settings (copy to .env, never commit real values)
# Credentials come from the environment only; nothing is hardcoded in source.

# --- Required: choose the database type ---
# One of: oracle | postgresql | mysql | mariadb | mssql | sqlite
DB_TYPE=oracle

# --- Connection (component form) ---
DB_HOST=db-host.example.com
DB_PORT=                       # optional; sensible default per DB_TYPE (oracle 1521, pg 5432, mysql 3306, mssql 1433)
DB_USER=your_readonly_user
DB_PASSWORD=
# Database/service name. For Oracle this is the SERVICE NAME; for SQLite it is the file path.
DB_NAME=ORCLPDB1

# --- OR: full SQLAlchemy URL (overrides the component vars above) ---
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_URL=oracle+oracledb://user:pass@host:1521/?service_name=ORCLPDB1
# DATABASE_URL=sqlite:///C:/path/to/local.db

# --- SQL Server only ---
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Optional: safety / performance knobs ---
DB_MAX_ROWS=100                # hard ceiling on rows returned per query
DB_QUERY_TIMEOUT=30            # seconds; best-effort statement timeout where supported
DB_POOL_MIN=1
DB_POOL_MAX=5
